# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/crm_db?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Server
PORT=3001
NODE_ENV=development

# CORS
CORS_ORIGIN="http://localhost:8081,http://localhost:19006,http://localhost:3000"

# SMTP welcome emails
# Gmail: use an App Password, not your normal Gmail password.
# Resend SMTP: SMTP_HOST=smtp.resend.com, SMTP_PORT=465, SMTP_USER=resend, SMTP_PASS=<api-key>, SMTP_FROM="Nova CRM <verified@domain.com>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Nova CRM <no-reply@example.com>"
APP_URL="https://your-frontend-domain.com"
MAIL_TEST_TO=""

# Deployment bootstrap super admin
# Required in production before running: npm run deploy:init
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL="superadmin@yourcompany.com"
SUPER_ADMIN_PASSWORD="change-this-strong-password"
SUPER_ADMIN_COMPANY="Platform"
SUPER_ADMIN_DEPARTMENT="Platform"
SUPER_ADMIN_PHONE=""

# Optional platform company metadata
PLATFORM_DIRECTOR=""
PLATFORM_GST_NO=""
PLATFORM_PHONE=""
